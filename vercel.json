{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/notiziario-parrocchiale/:path*", "destination": "/avvisi", "permanent": true },
    { "source": "/calendario/:path*", "destination": "/avvisi", "permanent": true },
    { "source": "/category/:path*", "destination": "/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true },
    { "source": "/:post(test|prova)/:path*", "destination": "/", "permanent": true }
  ]
}
